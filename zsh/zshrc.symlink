# source antidote
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh

zstyle ':zephyr:plugin:completion' use-cache yes

# initialize plugins statically with ${ZDOTDIR:-$HOME}/.zsh_plugins.txt
antidote load

zstyle ':completion:*' menu select

setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_NO_FUNCTIONS
setopt EXTENDED_HISTORY
setopt HIST_FCNTL_LOCK
setopt +o nomatch

# zsh keeps one empty column after RPROMPT by default. 0 puts the right prompt at the edge.
ZLE_RPROMPT_INDENT=0
NODE_OPTIONS="--max-old-space-size=8192"

source "$DOTFILES_PATH/zsh/exports.sh"
source "$DOTFILES_PATH/zsh/aliases.sh"
source "$DOTFILES_PATH/zsh/functions.sh"

# every function file under zsh/functions/ (alphabetical order)
for _fn_file in "$DOTFILES_PATH"/zsh/functions/*.(zsh|sh)(N); do
    source "$_fn_file"
done
unset _fn_file

source "$DOTFILES_PATH/zsh/key-bindings.zsh"

_cached_eval() {
    local bin=${commands[$1]:A} cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$1-init.zsh" first
    [[ -r $cache ]] && read -r first < $cache
    if [[ $first != "# $bin" ]]; then
        mkdir -p ${cache:h}
        { print -r -- "# $bin"; "$@" } > $cache
    fi
    source $cache
}

_cached_eval starship init zsh
_cached_eval zoxide init zsh
eval "$(mise activate zsh)"
unfunction _cached_eval

