# curl options for Homebrew. brew.sh gives this file to brew through
# HOMEBREW_CURLRC.
#
# Homebrew starts curl without a connect timeout. A download host that does
# not answer, or a download that stops, blocks the installation for ever.

# Stop when the host does not answer in 15 seconds.
connect-timeout = 15

# Stop when the speed stays below 1 KB/s for 60 seconds.
speed-limit = 1024
speed-time = 60
